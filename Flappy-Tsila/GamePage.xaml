<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Flappy_Tsila.GamePage"
             BackgroundColor="#70C5CE">

    <Grid x:Name="GameArea">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnGameTapped" />
        </Grid.GestureRecognizers>

        <Image Source="background_day.png" Aspect="AspectFill" />

        <Image x:Name="TopPipe" Source="pipe_green.png"
               WidthRequest="80" HeightRequest="420"
               Rotation="180"
               HorizontalOptions="Start"
               VerticalOptions="Start" />

        <Image x:Name="BottomPipe" Source="pipe_green.png"
               WidthRequest="80" HeightRequest="420"
               HorizontalOptions="Start"
               VerticalOptions="Start" />

        <Image x:Name="Bird" Source="tsilabird.png"
               WidthRequest="100" HeightRequest="70"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Label x:Name="ScoreLabel"
               Text="0"
               FontSize="46"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,35,0,0" />

        <VerticalStackLayout x:Name="GameOverPanel"
                             IsVisible="False"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="15">
            <Label Text="RESY IALAHY"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Button Text="HIPODY HISOMA"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#FFD447"
                    TextColor="#222222"
                    CornerRadius="25"
                    Padding="35,12"
                    Clicked="OnRestartClicked" />
        </VerticalStackLayout>

        <Image Source="base.png"
               Aspect="Fill"
               HeightRequest="100"
               VerticalOptions="End" />
    </Grid>
</ContentPage>