<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Flappy_Tsila.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#70C5CE">

    <Grid>
        <Image Source="background_day.png"
               Aspect="AspectFill" />

        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="18"
                             Padding="25"
                             Margin="0,-55,0,0">

            <Label x:Name="TitleLabel"
                   Text="ZEU&#10;TSILA"
                   FontFamily="Impact"
                   FontSize="52"
                   FontAttributes="Bold"
                   TextColor="White"
                   CharacterSpacing="5"
                   HorizontalTextAlignment="Center"
                   Shadow="{Shadow Brush=#3D2B3D, Offset='5,5', Radius=1}" />

            <Label x:Name="SubTitleLabel"
                   Text="Jeu tsy an-jaza izy ty zalahy"
                   FontSize="15"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Image x:Name="BirdImage"
                   Source="tsilabird.png"
                   WidthRequest="80"
                   HeightRequest="60"
                   HorizontalOptions="Center" />

            <Button x:Name="PlayButton"
                    Text="PLAY"
                    FontSize="22"
                    FontAttributes="Bold"
                    BackgroundColor="#FFD447"
                    TextColor="#222222"
                    CornerRadius="30"
                    Padding="55,14"
                    BorderColor="#222222"
                    BorderWidth="3" 
                    Clicked="OnPlayClicked" />

        </VerticalStackLayout>

        <VerticalStackLayout VerticalOptions="End"
                             HorizontalOptions="Center"
                             Spacing="5"
                             Padding="20"
                             Margin="0,0,0,105">

            <Label x:Name="CreditLabel"
                   Text="Norihy"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Shadow="{Shadow Brush=#000000, Offset='1,1', Radius=2}" />

            <Label x:Name="DedicateLabel"
                   Text="Nizaniza • Method TEAM"
                   FontSize="12"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Shadow="{Shadow Brush=#000000, Offset='1,1', Radius=2}" />

        </VerticalStackLayout>

        <Image Source="base.png"
               Aspect="Fill"
               HeightRequest="100"
               VerticalOptions="End" />
    </Grid>

</ContentPage>